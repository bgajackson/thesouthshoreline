---
layout: layouts/base.njk
permalink: /
---
{% from "event-line-list.njk" import eventLineList %}
{% set todayEvents = collections.events | happeningToday %}

<div class="wrap">
  <div class="page-header">
    <h1>{{ site.tagline }}</h1>
    <p>{{ site.description }}</p>
  </div>

  <div class="layout-with-sidebar">
    <div>
      <div class="section-header">
        <h2 id="today-heading">Today on the Line</h2>
        <button type="button" id="today-back" class="btn-subtle" hidden>Back to Today</button>
      </div>
      <div id="today-content">
        {% if todayEvents.length %}
          {{ eventLineList(todayEvents) }}
        {% else %}
          <p class="empty-state">Nothing submitted for today yet. <a href="/events/">See all upcoming events</a> or <a href="/submit/">submit one</a>.</p>
        {% endif %}
      </div>
    </div>

    <div>
      {% include "calendar-grid.njk" %}
      {% include "tides-widget.njk" %}
    </div>
  </div>
</div>
